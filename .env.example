# Copy this file to ".env" and fill in the values. The .env file itself is
# git-ignored — real values never enter the repository.

# MongoDB connection string (from MongoDB Atlas > Connect > Drivers).
# Contains the database password — treat it like a key.
MONGODB_URI=

# Port the server listens on (the hosting platform sets this automatically).
PORT=4000

# Key required in the "x-admin-key" header to list/read/update orders.
# Choose a long random value; the site owner keeps it private.
ADMIN_KEY=

# The website origin allowed to call this API (comma-separated if several).
CORS_ORIGIN=https://randhirsingh77.github.io
